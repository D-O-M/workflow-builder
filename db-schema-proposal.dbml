// Historical schema proposal. See Backend.Database.Relational/BlueprintDbContext.cs and its Migrations folder for the implemented SQL model.
table Blueprints as BP {
    Id int [primary key]
    Name string
    Version int
    StartingBlueprintNodeId guid [ref: > TI.Id]
}

table BlueprintNodes as TI {
    Id guid [primary key]
    BlueprintId int [ref: > BP.Id]
    TaskId int [ref: > T.Id]
}

table BlueprintConnections as TC {
    Id guid [primary key]
    SourceBlueprintNodeId guid [ref: > TI.Id, null]
    DestinationBlueprintNodeId guid [ref: > TI.Id, null]
    ChannelId int [ref: > C.Id]
}

table Tasks as T {
    Id int [primary key]
    Name string
    Version int
    Path string
}

enum ChannelDiscriminator {
    Input
    Output
}

table Channels as C {
    Id int [primary key]
    Name string
    Discriminator ChannelDiscriminator
    TaskId int [ref: > T.Id]
}

enum PrimitiveTypes {
    integer
    string
    guid
    boolean
}

table ChannelProperties as CP {
    Id int [primary key]
    Name string
    Type PrimitiveTypes
    ChannelId int [ref: > C.Id]
}
