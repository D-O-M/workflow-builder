{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ServiceBus": "<service_bus_connection_string>"
  },
  "AzureServiceBus": {
    "Queues": {
      "ProcessStepQueue": "<process_step_queue_name>",
      "PluginControlQueue": "<plugin_reload_queue_name>"
    }
  },
  "DebuggerAutoAttach": {
    "Enabled": false,
    "SolutionPaths": [],
    "PollingIntervalMilliseconds": 500,
    "TimeoutMilliseconds": 5000,
    "LaunchIfMissing": false,
    "LaunchSolutionPaths": []
  },
  "PluginRuntime": {
    "MaxConcurrentResultFinalizations": 16,
    "ResultFinalizationQueueCapacity": 1024,
    "ResultFinalizationQueueFullMode": "Wait",
    "HeartbeatIntervalSeconds": 10
  },
  "PluginAgentHealth": {
    "MaxMalformedFramesBeforeQuarantine": 5,
    "MaxCrashesPerWindow": 3,
    "CrashWindowSeconds": 300,
    "HeartbeatTimeoutSeconds": 30,
    "RestartBackoffSeconds": 5
  },
  "ProcessStepQueue": {
    "MaxConcurrentMessages": 8,
    "PrefetchCount": 32,
    "MaxAutoLockRenewalMinutes": 5,
    "ActiveMessageLockRenewalEnabled": true,
    "RenewalLeadTimeSeconds": 20,
    "MaxActiveRenewalDurationMinutes": 30
  },
  "Projections": {
    "SynchronousEngineUpdatesEnabled": true
  },
  "CollectionIterator": {
    "MaxItems": 1000,
    "BatchSize": 100
  }
}
