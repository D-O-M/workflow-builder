{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ServiceBus": "<service_bus_connection_string>"
  },
  "AzureServiceBus": {
    "Queues": {
      "WorkflowTaskQueue": "<workflow_task_queue_name>",
      "PluginControlQueue": "<plugin_reload_queue_name>"
    }
  },
  "DebuggerAutoAttach": {
    "Enabled": false,
    "SolutionPaths": [],
    "PollingIntervalMilliseconds": 500,
    "TimeoutMilliseconds": 5000,
    "LaunchIfMissing": false,
    "LaunchSolutionPaths": []
  }
}
