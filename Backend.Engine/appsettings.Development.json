{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ServiceBus": "<service_bus_connection_string>"
  },
  "AzureServiceBus": {
    "Queues": {
      "ProcessStepQueue": "<process_step_queue_name>",
      "PluginControlQueue": "<plugin_reload_queue_name>"
    }
  },
  "DebuggerAutoAttach": {
    "Enabled": true,
    "SolutionPaths": [
      "C:/src/workflow-builder/Backend.sln",
      "C:/src/plugin-repo/PluginOnly.sln"
    ],
    "PollingIntervalMilliseconds": 500,
    "TimeoutMilliseconds": 10000,
    "LaunchIfMissing": true,
    "LaunchSolutionPaths": [
      "C:/src/workflow-builder/Backend.sln"
    ]
  },
  "PluginRuntime": {
    "MaxConcurrentResultFinalizations": 16
  },
  "ProcessStepQueue": {
    "MaxConcurrentMessages": 8,
    "PrefetchCount": 32,
    "MaxAutoLockRenewalMinutes": 5
  }
}
