{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:15280",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_DASHBOARD_OTLP_ENDPOINT_URL": "http://localhost:19230",
        "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
        "ASPIRE_DASHBOARD_UNSECURED_ALLOW_ANONYMOUS": "true",
        "Frontend__Enabled": "false",
        "AzureServiceBus__Queues__PluginControlQueue__ResourceName": "plugin-control-queue",
        "AzureServiceBus__Queues__PluginControlQueue__ConnectionName": "plugin-control-queue",
        "AzureServiceBus__Queues__PluginControlQueue__Name": "pluginreloadqueue"
      }
    },
    "nft": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:15280",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_DASHBOARD_OTLP_ENDPOINT_URL": "http://localhost:19230",
        "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
        "ASPIRE_DASHBOARD_UNSECURED_ALLOW_ANONYMOUS": "true",
        "Frontend__Enabled": "false",
        "Observability__Enabled": "false",
        "Nft__Enabled": "true",
        "Nft__MinimalServices": "true",
        "Nft__PluginRuntime__MaxConcurrentResultFinalizations": "80",
        "Nft__ProcessStepQueue__MaxConcurrentMessages": "32",
        "Nft__ProcessStepQueue__PrefetchCount": "128",
        "Nft__ProcessStepQueue__MaxAutoLockRenewalMinutes": "5",
        "SignalR__Enabled": "false",
        "ProgressBroadcaster__Enabled": "false",
        "Dispatcher__Enabled": "true",
        "ProjectionWorker__Enabled": "true",
        "Maintenance__Enabled": "false",
        "PluginDetector__Enabled": "false",
        "Projections__SynchronousEngineUpdatesEnabled": "false",
        "AzureServiceBus__Queues__PluginControlQueue__ResourceName": "plugin-control-queue",
        "AzureServiceBus__Queues__PluginControlQueue__ConnectionName": "plugin-control-queue",
        "AzureServiceBus__Queues__PluginControlQueue__Name": "pluginreloadqueue"
      }
    }
  }
}
