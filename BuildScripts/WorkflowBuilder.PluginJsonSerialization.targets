<Project>
  <UsingTask
    TaskName="GenerateWorkflowBuilderPluginJsonSerializerContext"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <CompileFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
var serializableTypes = new SortedSet<string>(StringComparer.Ordinal);
var attributePattern = new Regex(
    @"(?s)\[(?:[^\[\]]*\bPluginJsonSerializable(?:Attribute)?\b[^\[\]]*)\]\s*(?:\[[^\[\]]+\]\s*)*(?:(?:public|internal|private|protected|sealed|abstract|partial|static|readonly)\s+)*(?:class|struct|record\s+(?:class\s+|struct\s+)?)\s+([A-Za-z_][A-Za-z0-9_]*)",
    RegexOptions.Compiled);
var fileScopedNamespacePattern = new Regex(
    @"(?m)^\s*namespace\s+([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)\s*;",
    RegexOptions.Compiled);
var blockNamespacePattern = new Regex(
    @"(?m)^\s*namespace\s+([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)\s*\{",
    RegexOptions.Compiled);

foreach (var item in CompileFiles ?? Array.Empty<Microsoft.Build.Framework.ITaskItem>())
{
    var path = item.GetMetadata("FullPath");
    if (string.IsNullOrWhiteSpace(path))
    {
        path = item.ItemSpec;
    }

    if (string.IsNullOrWhiteSpace(path) ||
        !File.Exists(path) ||
        Path.GetFileName(path).Equals("WorkflowBuilderPluginJsonSerializerContext.g.cs", StringComparison.OrdinalIgnoreCase))
    {
        continue;
    }

    var source = File.ReadAllText(path);
    if (source.IndexOf("PluginJsonSerializable", StringComparison.Ordinal) < 0)
    {
        continue;
    }

    var namespaceName = "";
    var fileScopedNamespace = fileScopedNamespacePattern.Match(source);
    if (fileScopedNamespace.Success)
    {
        namespaceName = fileScopedNamespace.Groups[1].Value;
    }
    else
    {
        var blockNamespace = blockNamespacePattern.Match(source);
        if (blockNamespace.Success)
        {
            namespaceName = blockNamespace.Groups[1].Value;
        }
    }

    foreach (Match match in attributePattern.Matches(source))
    {
        var typeName = match.Groups[1].Value;
        serializableTypes.Add(
            string.IsNullOrWhiteSpace(namespaceName)
                ? $"global::{typeName}"
                : $"global::{namespaceName}.{typeName}");
    }
}

Directory.CreateDirectory(Path.GetDirectoryName(OutputFile)!);

if (serializableTypes.Count == 0)
{
    if (File.Exists(OutputFile))
    {
        File.Delete(OutputFile);
    }
}
else
{
    var builder = new StringBuilder();
    builder.AppendLine("// <auto-generated />");
    builder.AppendLine("#nullable enable");
    builder.AppendLine("using System.Text.Json.Serialization;");
    builder.AppendLine();
    builder.AppendLine("[assembly: System.Reflection.AssemblyMetadata(\"WorkflowBuilder.PluginJsonSerializerContext\", \"WorkflowBuilder.Generated.WorkflowBuilderPluginJsonSerializerContext\")]");
    builder.AppendLine();
    builder.AppendLine("namespace WorkflowBuilder.Generated;");
    builder.AppendLine();
    builder.AppendLine("[JsonSourceGenerationOptions(GenerationMode = JsonSourceGenerationMode.Metadata)]");
    foreach (var serializableType in serializableTypes)
    {
        builder.AppendLine($"[JsonSerializable(typeof({serializableType}))]");
    }

    builder.AppendLine("internal partial class WorkflowBuilderPluginJsonSerializerContext : JsonSerializerContext");
    builder.AppendLine("{");
    builder.AppendLine("}");

    var generatedSource = builder.ToString();
    if (!File.Exists(OutputFile) || !string.Equals(File.ReadAllText(OutputFile), generatedSource, StringComparison.Ordinal))
    {
        File.WriteAllText(OutputFile, generatedSource);
    }
}
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateWorkflowBuilderPluginJsonSerializerContext" BeforeTargets="CoreCompile" Condition="'$(WorkflowBuilderPluginProject)' == 'true'">
    <PropertyGroup>
      <WorkflowBuilderPluginJsonSerializerContextFile>$(IntermediateOutputPath)WorkflowBuilderPluginJsonSerializerContext.g.cs</WorkflowBuilderPluginJsonSerializerContextFile>
    </PropertyGroup>

    <GenerateWorkflowBuilderPluginJsonSerializerContext
      CompileFiles="@(Compile)"
      OutputFile="$(WorkflowBuilderPluginJsonSerializerContextFile)" />

    <ItemGroup Condition="Exists('$(WorkflowBuilderPluginJsonSerializerContextFile)')">
      <Compile Include="$(WorkflowBuilderPluginJsonSerializerContextFile)" Link="WorkflowBuilderPluginJsonSerializerContext.g.cs" Visible="false" />
      <FileWrites Include="$(WorkflowBuilderPluginJsonSerializerContextFile)" />
    </ItemGroup>
  </Target>
</Project>
